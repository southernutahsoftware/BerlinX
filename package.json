{
  "name": "berlinx",
  "version": "1.2.0",
  "description": "A powerful semantic CSS library, with optional custom elements for app controls",
  "license": "MIT",
  "author": "Southern Utah Software",
  "homepage": "https://berlinx.southernutahsoftware.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/southernutahsoftware/BerlinX.git"
  },
  "bugs": {
    "url": "https://github.com/southernutahsoftware/BerlinX/issues"
  },
  "keywords": [
    "css",
    "classless",
    "semantic",
    "css-library",
    "css-framework",
    "html",
    "no-class",
    "minimal",
    "web-components",
    "custom-elements"
  ],
  "main": "dist/berlinx.css",
  "style": "dist/berlinx.css",
  "unpkg": "dist/berlinx.min.css",
  "jsdelivr": "dist/berlinx.min.css",
  "exports": {
    ".": "./dist/berlinx.css",
    "./css": "./dist/berlinx.css",
    "./min": "./dist/berlinx.min.css",
    "./elements.css": "./dist/berlinx-elements.css",
    "./elements.min.css": "./dist/berlinx-elements.min.css",
    "./material.css": "./dist/berlinx-material.css",
    "./material.min.css": "./dist/berlinx-material.min.css",
    "./elements": {
      "types": "./dist/elements/index.d.ts",
      "default": "./dist/elements/index.js"
    },
    "./elements/*": {
      "types": "./dist/elements/*.d.ts",
      "default": "./dist/elements/*.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "css/berlinx.css",
    "css/elements.css",
    "css/material.css",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css",
    "./elements/**",
    "./dist/elements/**"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "deploy": "npm run build && wrangler deploy",
    "prepack": "npm run build",
    "test": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "atomico": "2.2.0",
    "esbuild": "0.28.2",
    "lightningcss": "1.33.0",
    "marked": "18.1.1"
  },
  "browserslist": [
    "Chrome >= 114",
    "Edge >= 114",
    "Firefox >= 125",
    "Safari >= 17"
  ]
}
